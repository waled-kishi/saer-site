{% extends 'partials/base.html.twig' %}
{#
  Home page built from sections. Their order comes from header.sections, a list the admin
  can drag to reorder; leaving a section out hides it (its texts stay saved).
  Each section is partials/home/<type>.html.twig and reads its texts from the page header:
    hero, stats, featured, more, questions, quote, content, cta
#}
{%- set h = page.header -%}
{%- set default_sections = ['hero', 'stats', 'featured', 'more', 'questions', 'quote', 'content', 'cta'] -%}
{%- set order = [] -%}
{%- for s in (h.sections ?: []) -%}
  {%- set t = s.type ?? s -%}
  {%- if t in default_sections -%}{%- set order = order|merge([t]) -%}{%- endif -%}
{%- endfor -%}
{%- set order = order ?: default_sections -%}
{% block content %}
  {% for t in order %}
    {%- set out -%}{% include 'partials/home/' ~ t ~ '.html.twig' %}{%- endset -%}
    {% if out|trim %}<section class="home-block home-block--{{ t }}">{{ out|raw }}</section>{% endif %}
  {% endfor %}
{% endblock %}
