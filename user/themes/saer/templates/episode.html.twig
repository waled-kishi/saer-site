{% extends 'partials/base.html.twig' %}
{%- set h = page.header -%}
{%- set series = page.parent -%}
{%- set sibs = series ? series.children.visible|filter(s => s.template != 'series') : [] -%}
{%- set idx = 0 -%}
{%- for s in sibs -%}{%- if s.route == page.route -%}{%- set idx = loop.index -%}{%- endif -%}{%- endfor -%}
{%- set prev = idx > 1 ? sibs|slice(idx - 2, 1)|first : null -%}
{%- set next = idx and idx < sibs|length ? sibs|slice(idx, 1)|first : null -%}
{%- set book = series and series.header.book ? pages.find(series.header.book) : null -%}

{% block head_extra %}
{%- set vid = (h.youtube ?? '')|yt_id -%}
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"{{ vid ? 'VideoObject' : 'Article' }}",
 "name":"{{ page.title|e('js') }}","headline":"{{ page.title|e('js') }}",
 "description":"{{ (h.summary ?: page.summary(160)|striptags)|e('js') }}",
 {% if vid %}"thumbnailUrl":"https://i.ytimg.com/vi/{{ vid }}/hqdefault.jpg","embedUrl":"https://www.youtube.com/embed/{{ vid }}","uploadDate":"{{ page.date|date('c') }}",{% endif %}
 "inLanguage":"ar","author":{"@type":"Person","name":"محمد سائر الشبعان"},"url":"{{ page.url(true)|e('js') }}"}
</script>
{% endblock %}

{% block content %}
<section class="wrap wrap--narrow page-head" style="padding-top:56px;padding-bottom:56px;gap:20px">
  {% include 'partials/breadcrumbs.html.twig' with {label: 'الحلقة ' ~ (h.number ?: idx)} %}
  <span class="chip chip--gold" style="align-self:flex-start;margin-top:10px">
    {%- if series.header.step_label %}{{ series.header.step_label }} · {% endif -%}
    الحلقة {{ h.number ?: idx }}{% if sibs|length > 1 %} من {{ sibs|length }}{% endif %}
    {%- if h.duration %} · {{ h.duration }}{% endif -%}
  </span>
  <h1 style="font-size:clamp(36px,5.4vw,66px)">{{ page.title }}</h1>
  <div class="byline"><span>تقديم: أ. سائر</span></div>
  <div id="video">{% include 'partials/youtube.html.twig' with {yt: h.youtube, title: page.title} %}</div>
</section>

<section class="wrap layout">
  <article class="prose">
    {% if page.content|trim %}
      {{ page.content|raw }}
    {% else %}
      <p class="mut">النص المكتوب لهذه الحلقة غير متوفر بعد؛ يمكنك مشاهدتها في الأعلى.</p>
    {% endif %}
    <nav class="pager" aria-label="التنقل بين الحلقات">
      {% if series %}<a href="{{ series.url }}" class="btn ghost" style="min-height:50px">كل حلقات السلسلة</a>{% endif %}
      {% if prev %}<a href="{{ prev.url }}" class="btn ghost" style="min-height:50px">→ السابق: {{ prev.title }}</a>{% endif %}
      {% if next %}<a href="{{ next.url }}" class="btn gold" style="min-height:50px">التالي: {{ next.title }} ←</a>{% endif %}
    </nav>
  </article>

  <aside class="aside">
    {% if sibs|length > 1 %}
    <div class="glass box">
      <h2 class="k">حلقات السلسلة</h2>
      <ol class="toc">
        {% for s in sibs %}
          <li><a href="{{ s.url }}"{% if s.route == page.route %} aria-current="page"{% endif %}><span>{{ s.header.number ?: loop.index }}</span>{{ s.title }}</a></li>
        {% endfor %}
      </ol>
    </div>
    {% endif %}
    {% include 'partials/download-box.html.twig' with {book: book} %}
  </aside>
</section>
{% endblock %}
