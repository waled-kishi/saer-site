{# Shared listing body. Expects: grid (css class), empty_msg, items (optional) #}
<section class="wrap page-head">
  {% include 'partials/breadcrumbs.html.twig' %}
  <h1>{{ page.title }}</h1>
  {% if page.header.summary %}<p class="lead">{{ page.header.summary }}</p>{% endif %}
  {% if page.content|trim %}<div class="prose">{{ page.content|raw }}</div>{% endif %}
</section>
<section class="wrap" style="padding-bottom:96px">
  {% set items = items ?? page.children.visible %}
  {% if items|length %}
    <div class="{{ grid ?? 'grid3' }}">
      {% for item in items %}{% include 'partials/card.html.twig' with {item: item} %}{% endfor %}
    </div>
  {% else %}
    {% include 'partials/empty.html.twig' with {msg: empty_msg ?? 'لا يوجد محتوى منشور هنا بعد. قريباً بإذن الله.'} %}
  {% endif %}
</section>
