{%- set tc = config.theme -%}
{%- set h = page.header -%}
{%- set soon = (h.coming_soon ?? false) or (page.parent and (page.parent.header.coming_soon ?? false)) -%}
{%- set page_title = (h.seo.title ?? null) ?: (page.home ? site.title : page.title ~ ' | ' ~ site.title) -%}
{%- set page_desc = (h.seo.description ?? null) ?: ((h.summary ?? null) ?: (page.summary(160)|striptags|trim ?: site.metadata.description)) -%}
<!doctype html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>{{ page_title }}</title>
  <meta name="description" content="{{ page_desc }}">
  {% if soon %}<meta name="robots" content="noindex">{% endif %}
  <link rel="canonical" href="{{ page.canonical(true) }}">
  <meta property="og:type" content="{{ page.template == 'episode' or page.template == 'article' ? 'article' : 'website' }}">
  <meta property="og:title" content="{{ page_title }}">
  <meta property="og:description" content="{{ page_desc }}">
  <meta property="og:url" content="{{ page.url(true) }}">
  <meta property="og:locale" content="ar_AR">
  <meta property="og:site_name" content="{{ site.title }}">
  {%- set og_img = (page.media.images|first) -%}
  {%- set og_url = og_img ? url(og_img.cropZoom(1200,630).url(), true) : url('theme://images/og-default.jpg', true) -%}
  <meta property="og:image" content="{{ og_url }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="{{ page_title }}">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ page_title }}">
  <meta name="twitter:description" content="{{ page_desc }}">
  <meta name="twitter:image" content="{{ og_url }}">
  <meta name="theme-color" content="#150826">
  {% block stylesheets %}
    {% do assets.addCss('theme://css/fonts.css'|asset_v, 100) %}
    {% do assets.addCss('theme://css/theme.css'|asset_v, 99) %}
  {% endblock %}
  {{ assets.css()|raw }}
  {% block head_extra %}{% endblock %}
</head>
<body class="tpl-{{ page.template }}" id="top">
  <a class="skip" href="#main">تخطَّ إلى المحتوى</a>
  {% include 'partials/header.html.twig' %}
  <main id="main">
    {% if soon %}{% include 'partials/coming-soon.html.twig' %}{% else %}{% block content %}{% endblock %}{% endif %}
  </main>
  {% include 'partials/footer.html.twig' %}
  <a href="#top" class="to-top" id="to-top" aria-label="العودة إلى أعلى الصفحة" hidden>
    <svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19V5"/><path d="M5 12l7-7 7 7"/></svg>
  </a>
  {% do assets.addJs('theme://js/site.js'|asset_v, {group: 'bottom', loading: 'defer'}) %}
  {{ assets.js()|raw }}
  {{ assets.js('bottom')|raw }}
</body>
</html>
