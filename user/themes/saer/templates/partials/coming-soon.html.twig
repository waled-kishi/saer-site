{# Shown instead of a page's content when header.coming_soon is on. #}
<section class="wrap page-head" style="padding-bottom:96px">
  {% include 'partials/breadcrumbs.html.twig' %}
  <div class="glass soon">
    <span class="chip chip--gold">قريباً بإذن الله</span>
    <h1>{{ page.title }}</h1>
    {% if page.header.summary %}<p class="lead">{{ page.header.summary }}</p>{% endif %}
    <p class="mut">نعمل على تجهيز هذا القسم، وسيُنشر هنا قريباً.</p>
    <div class="actions" style="justify-content:center">
      <a href="{{ home_url }}" class="btn ghost">الرئيسية</a>
      {% set progs = pages.find('/programs') %}
      {% if progs %}<a href="{{ progs.url }}" class="btn gold">تصفّح البرامج</a>{% endif %}
    </div>
  </div>
</section>
