{# One row in a numbered list (episodes, lessons…). Expects: item, n #}
{%- set h = item.header -%}
<li class="glass row">
  <span class="row__num">{% if h.label and not h.number %}<span style="font-size:18px">{{ h.label }}</span>{% else %}{{ n|ar_digits }}{% endif %}</span>
  <div class="row__body">
    <h3><a href="{{ item.url }}">{{ item.title }}</a></h3>
    {% if h.summary %}<p class="mut" style="font-size:16px">{{ h.summary }}</p>{% endif %}
  </div>
  {% if h.duration %}<span class="chip">{{ h.duration }}</span>{% endif %}
  <div class="row__actions">
    {% if item.content|trim %}<a href="{{ item.url }}" class="btn gold btn--sm">اقرأ</a>{% endif %}
    {% if h.youtube %}<a href="{{ item.url }}#video" class="btn ghost btn--sm">شاهد</a>{% endif %}
  </div>
</li>
