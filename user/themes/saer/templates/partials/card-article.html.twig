{# Card for an article. Expects: item #}
{%- set h = item.header -%}
{%- set img = media_pick(item, h.image)|first -%}
{%- set mins = max(1, ((item.content|striptags|split(' ')|length) / 200)|round(0, 'ceil')) -%}
<article class="glass card">
  {% if img and img.medium %}<a href="{{ item.url }}" tabindex="-1" aria-hidden="true">{{ img.medium.cropZoom(640,400).html('', item.title, 'card__img')|raw }}</a>{% endif %}
  <div class="card__top"><span class="chip">{{ item.date|date('Y/m/d') }} · {{ mins }} د قراءة</span></div>
  <h3><a href="{{ item.url }}" style="color:inherit">{{ item.title }}</a></h3>
  <p class="mut" style="font-size:17px">{{ h.summary ?: item.summary(160)|striptags }}</p>
  <div class="card__actions"><a href="{{ item.url }}" class="btn ghost">اقرأ المقال</a></div>
</article>
