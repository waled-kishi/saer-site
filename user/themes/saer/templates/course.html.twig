{% extends 'partials/base.html.twig' %}
{#
  A course landing page. Every section appears only when the page carries its field.
  Registration: register_mode external | internal | none, open only while the status is
  "open", the link or form is there and the deadline has not passed.
  The special offer (popup + floating chip) runs a real window per visitor: when it ends,
  the special price is gone from the page, so it has to be honoured that way.
#}
{%- set h = page.header -%}
{%- set img = media_pick(page, h.image)|first -%}
{%- set qr = media_pick(page, h.pay_qr)|first -%}
{%- set st = {soon: 'التسجيل قريباً', open: 'التسجيل مفتوح', closed: 'التسجيل مغلق', done: 'انتهت الدورة'} -%}
{%- set expired = h.register_deadline and date(h.register_deadline) < date('today') -%}
{%- set internal = h.register_mode == 'internal' -%}
{%- set can_register = h.status == 'open' and h.register_mode != 'none' and not expired and (internal or h.register_url) -%}
{%- set cta_label = h.register_label ?: 'سجّل الآن' -%}
{%- set cta_href = internal ? '#register' : h.register_url -%}
{%- set blank = internal ? '' : 'target="_blank" rel="noopener"' -%}
{%- set wa = h.whatsapp ? 'https://wa.me/' ~ h.whatsapp|replace({'+':'', ' ':'', '-':''}) ~ (h.whatsapp_text ? '?text=' ~ h.whatsapp_text|url_encode) -%}
{%- set n_before = h.price_before|replace({'$':'', ',':'', ' ':''})|trim -%}
{%- set n_now = h.price|replace({'$':'', ',':'', ' ':''})|trim -%}
{%- set off = (n_before matches '/^\\d+(\\.\\d+)?$/' and n_now matches '/^\\d+(\\.\\d+)?$/' and n_before > 0) ? ((1 - n_now / n_before) * 100)|round : 0 -%}
{%- set headline = (h.promise ?: page.title)|replace({'«': '<span class="hl">', '»': '</span>'}) -%}

{% block head_extra %}
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"Course","name":"{{ page.title|e('js') }}","inLanguage":"ar",
 "description":"{{ (h.summary ?: page.summary(160)|striptags)|e('js') }}",
 "provider":{"@type":"Person","name":"محمد سائر الشبعان"},"url":"{{ page.url(true)|e('js') }}"}
</script>
{% if h.faq %}
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[
{% for f in h.faq %}{"@type":"Question","name":"{{ f.q|e('js') }}","acceptedAnswer":{"@type":"Answer","text":"{{ f.a|e('js') }}"}}{{ not loop.last ? ',' }}{% endfor %}]}
</script>
{% endif %}
{% endblock %}

{% block content %}
{# ── شريط ثابت أعلى الشاشة ─────────────────────────────────── #}
{% if can_register %}
<div class="lp-top" id="lp-top" hidden>
  <b data-price>{{ h.price }}</b>{% if h.price_before %} <s class="mut" style="font-size:15px" data-was>{{ h.price_before }}</s>{% endif %}
  {% if h.register_deadline %}<span>التسجيل حتى {{ h.register_deadline|date('Y/m/d') }}</span>{% endif %}
  <a class="btn gold btn--sm" href="{{ cta_href }}" {{ blank|raw }}>{{ cta_label }}</a>
</div>
{% endif %}

{# ── الواجهة ───────────────────────────────────────────────── #}
<section class="lp-hero-wrap">
  <div class="wrap lp-hero">
    <div class="lp-hero__text">
      <span class="lp-tag">{% include 'partials/lp-icons.html.twig' with {i:'spark', size:15} %} {{ h.batch ?: 'دورة تدريبية' }} · {{ expired and h.status == 'open' ? 'انتهى التسجيل' : st[h.status ?: 'soon'] }}</span>
      <h1>{{ headline|raw }}</h1>
      {% if h.summary %}<p class="lp-lede">{{ h.summary }}</p>{% endif %}
      <div class="lp-facts">
        {% if h.start_date %}<span>{% include 'partials/lp-icons.html.twig' with {i:'clock', size:19} %}{{ h.start_date }}</span>{% endif %}
        {% if h.duration %}<span>{% include 'partials/lp-icons.html.twig' with {i:'replay', size:19} %}{{ h.duration }}</span>{% endif %}
        {% if h.format %}<span>{% include 'partials/lp-icons.html.twig' with {i:'video', size:19} %}{{ h.format }}</span>{% endif %}
        <span>{% include 'partials/lp-icons.html.twig' with {i:'award', size:19} %}شهادة حضور</span>
      </div>
    </div>

    <div class="lp-hero__side">
      {% if h.trailer %}<div class="lp-media">{% include 'partials/youtube.html.twig' with {yt: h.trailer, title: 'تعريف بدورة ' ~ page.title} %}</div>
      {% elseif img and img.medium %}<div class="article__img lp-media">{{ img.medium.cropZoom(900, 600).html('', page.title)|raw }}</div>
      {% else %}{% include 'partials/course-hero-art.html.twig' %}{% endif %}

      <div class="lp-offer">
        {% if off > 0 %}<span class="lp-off" data-off>خصم {{ off }}%</span>{% endif %}
        {% if h.price %}
          <div class="lp-pricerow">
            <b data-price>{{ h.price }}</b>
            {% if h.price_before %}<s data-was>{{ h.price_before }}</s>{% endif %}
          </div>
          {% if h.price_note %}<p class="lp-fine">{{ h.price_note }}</p>{% endif %}
        {% endif %}

        {% if h.countdown and h.register_deadline and not expired and h.status == 'open' %}
          {% include 'partials/course-countdown.html.twig' %}
        {% endif %}

        {% if can_register %}
          <a class="btn gold lp-go" href="{{ cta_href }}" data-cta {{ blank|raw }}>{{ cta_label }}</a>
          {% if wa %}<a class="btn ghost" href="{{ wa }}" data-wa target="_blank" rel="noopener">{{ h.whatsapp_label ?: 'تواصل على واتساب' }}</a>{% endif %}
          <ul class="lp-rsr">
            <li>{% include 'partials/lp-icons.html.twig' with {i:'check', size:17} %} مقعدك يُثبّت فور وصول الإشعار</li>
            <li>{% include 'partials/lp-icons.html.twig' with {i:'check', size:17} %} بياناتك لا تُنشر ولا تُشارك مع أحد</li>
          </ul>
        {% elseif expired and h.status == 'open' %}
          <span class="btn ghost" aria-disabled="true">انتهى موعد التسجيل</span>
        {% else %}
          <span class="btn ghost" aria-disabled="true">{{ st[h.status ?: 'soon'] }}</span>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{# ── شريط الثقة ────────────────────────────────────────────── #}
{% if h.trust_facts %}
<section class="lp-band"><div class="wrap lp-trust">
  {% for f in h.trust_facts %}
    {% set parts = f|split(' ', 2) %}
    <div><b>{{ parts[0] }}</b><span>{{ parts[1] ?? '' }}</span></div>
  {% endfor %}
</div></section>
{% endif %}

{# ── هل تجد نفسك هنا؟ ──────────────────────────────────────── #}
{% if h.pains %}
<section class="wrap sec sec--tight">
  <p class="lp-eyebrow" style="display:flex;width:fit-content">{% include 'partials/lp-icons.html.twig' with {i:'alert', size:16} %} قبل أن تقرأ عن الدورة</p>
  <h2 class="lp-h">هل تجد نفسك هنا؟</h2>
  <p class="lp-sub">ثلاث حالات يعرفها كثيرون ولا يسمّونها.</p>
  <div class="lp-cards">
    {% for p in h.pains %}
      <article class="lp-card"><span class="lp-ico">{% include 'partials/lp-icons.html.twig' with {i:'alert'} %}</span><p>{{ p }}</p></article>
    {% endfor %}
  </div>
</section>
{% endif %}

{# ── ماذا ستخرج به ─────────────────────────────────────────── #}
{% if h.goals %}
<section class="lp-band"><div class="wrap sec sec--tight">
  <h2 class="lp-h">ماذا ستخرج به</h2>
  <p class="lp-sub">نتائج تخرج بها معك، لا عناوين دروس.</p>
  <div class="lp-cards">
    {% for g in h.goals %}
      <article class="lp-card" style="flex-direction:row;align-items:flex-start;gap:14px"><span class="lp-num">{{ loop.index }}</span><p style="color:var(--ink)">{{ g }}</p></article>
    {% endfor %}
  </div>
</div></section>
{% endif %}

{# ── عن الدورة ─────────────────────────────────────────────── #}
{% if page.content|trim %}
<section class="wrap wrap--narrow sec sec--tight">
  <div class="lp-about">
    <span class="lp-about__mark" aria-hidden="true">”</span>
    <p class="lp-eyebrow" style="margin:0">{% include 'partials/lp-icons.html.twig' with {i:'spark', size:15} %} فكرة الدورة</p>
    <article class="prose">{{ page.content|raw }}</article>
  </div>
</section>
{% endif %}

{# ── المنهج ────────────────────────────────────────────────── #}
{% set plan = h.curriculum ?: (h.outline ? h.outline|map(c => {title: c, text: ''})) %}
{% if plan %}
<section class="wrap wrap--narrow sec sec--tight">
  <h2 class="lp-h">المنهج</h2>
  <p class="lp-sub">كل دائرة: ما هي، ولماذا تقع فيها، وأدوات الخروج منها، وتمرين تخرج به.</p>
  <ol class="lp-plan">
    {% for c in plan %}<li><span class="lp-num">{{ loop.index }}</span><div><b>{{ c.title }}</b>{% if c.text %}<p>{{ c.text }}</p>{% endif %}</div></li>{% endfor %}
  </ol>
  {% if can_register %}
  <div class="lp-cta" style="margin-top:34px">
    <a class="btn gold" href="{{ cta_href }}" {{ blank|raw }}>{{ cta_label }}</a>
    {% if h.price %}<p class="mut" style="margin:0;font-size:15px"><b data-price style="color:var(--gold)">{{ h.price }}</b>{% if h.price_before %} بدل <s data-was>{{ h.price_before }}</s>{% endif %}{% if h.register_deadline %} · حتى {{ h.register_deadline|date('Y/m/d') }}{% endif %}</p>{% endif %}
  </div>
  {% endif %}
</section>
{% endif %}

{# ── لمن هي ولمن ليست ──────────────────────────────────────── #}
{% if h.audience or h.not_for %}
<section class="lp-band"><div class="wrap sec sec--tight">
  <h2 class="lp-h">لمن هذه الدورة؟</h2>
  <div class="lp-two">
    {% if h.audience %}
      <div class="lp-card lp-yes"><span class="lp-ico lp-ico--gold">{% include 'partials/lp-icons.html.twig' with {i:'check'} %}</span>
        <b>هي لك إن…</b>
        <ul class="lp-list lp-yes">{% for line in h.audience|split("\n") %}{% if line|trim %}<li>{% include 'partials/lp-icons.html.twig' with {i:'check', size:20} %}<span>{{ line }}</span></li>{% endif %}{% endfor %}</ul>
      </div>
    {% endif %}
    {% if h.not_for %}
      <div class="lp-card lp-no"><span class="lp-ico">{% include 'partials/lp-icons.html.twig' with {i:'x'} %}</span>
        <b>وليست لك إن…</b>
        <ul class="lp-list lp-no">{% for n in h.not_for %}<li>{% include 'partials/lp-icons.html.twig' with {i:'x', size:20} %}<span>{{ n }}</span></li>{% endfor %}</ul>
      </div>
    {% endif %}
  </div>
</div></section>
{% endif %}

{# ── كيف تجري الدورة ───────────────────────────────────────── #}
{% if h.how_it_runs %}
<section class="wrap sec sec--tight">
  <h2 class="lp-h">كيف تجري الدورة</h2>
  <div class="lp-cards">
    {% set icons = ['video','clock','replay','award'] %}
    {% for r in h.how_it_runs %}
      <article class="lp-card"><span class="lp-ico lp-ico--gold">{% include 'partials/lp-icons.html.twig' with {i: icons[loop.index0 % 4]} %}</span><b>{{ r.title }}</b><p>{{ r.text }}</p></article>
    {% endfor %}
  </div>
</section>
{% endif %}

{# ── آراء المتدربين ────────────────────────────────────────── #}
{% if h.testimonials %}
<section class="lp-band"><div class="wrap sec sec--tight">
  <h2 class="lp-h">قالوا بعد الدورة</h2>
  <div class="lp-cards">
    {% for t in h.testimonials %}<figure class="lp-card lp-say"><blockquote>{{ t.text }}</blockquote><figcaption>{{ t.name }}</figcaption></figure>{% endfor %}
  </div>
</div></section>
{% endif %}

{# ── الأسئلة الشائعة ───────────────────────────────────────── #}
{% if h.faq %}
<section class="wrap wrap--narrow sec sec--tight">
  <h2 class="lp-h">الأسئلة الشائعة</h2>
  <div class="lp-faq">
    {% for f in h.faq %}<details class="glass"><summary>{{ f.q }}</summary><div>{{ f.a|nl2br }}</div></details>{% endfor %}
  </div>
</section>
{% endif %}

{# ── التسجيل والدفع ────────────────────────────────────────── #}
<section class="wrap wrap--narrow sec" id="register">
  <div class="glass lp-reg">
    <h2 class="lp-h" style="margin:0">{{ expired and h.status == 'open' ? 'انتهى موعد التسجيل' : (can_register ? 'احجز مقعدك' : st[h.status ?: 'soon']) }}</h2>

    {% if h.price %}
      <div class="lp-pricerow" style="justify-content:center">
        <b data-price>{{ h.price }}</b>
        {% if h.price_before %}<s data-was>{{ h.price_before }}</s>{% endif %}
        {% if off > 0 %}<span class="lp-off" data-off>خصم {{ off }}%</span>{% endif %}
      </div>
      {% if h.price_note %}<p class="mut" style="margin:-8px 0 0">{{ h.price_note }}</p>{% endif %}
      {% if h.popup and h.popup_price %}<p class="lp-hotline" data-offer-note hidden>{% include 'partials/lp-icons.html.twig' with {i:'spark', size:16} %} هذا سعرك الخاص ما دام العدّاد يعمل، وسيُسجَّل مع طلبك.</p>{% endif %}
    {% endif %}

    {% if h.register_deadline and not expired %}
      {% include 'partials/course-countdown.html.twig' with {label: 'يُغلق التسجيل بعد'} %}
    {% endif %}

    {% if can_register %}
      {% if qr and qr.medium %}
        <div class="lp-pay">
          <div class="lp-qr">{{ qr.medium.resize(320, 420).html('', h.pay_title ?: 'رمز الدفع')|raw }}</div>
          <div style="flex:1;min-width:200px"><b>{{ h.pay_title ?: 'ادفع الرسوم' }}</b>{% if h.pay_note %}<p>{{ h.pay_note|nl2br }}</p>{% endif %}</div>
        </div>
      {% elseif h.pay_note %}<p class="mut">{{ h.pay_note|nl2br }}</p>{% endif %}

      <div class="actions lp-actions">
        {% if wa %}<a class="btn gold" href="{{ wa }}" data-wa target="_blank" rel="noopener">{{ h.whatsapp_label ?: 'تواصل معنا على واتساب' }}</a>{% endif %}
        {% if internal %}<a class="btn {{ wa ? 'ghost' : 'gold' }}" href="#register-form">عبّئ نموذج التسجيل</a>
        {% else %}<a class="btn {{ wa ? 'ghost' : 'gold' }}" href="{{ h.register_url }}" target="_blank" rel="noopener">{{ cta_label }}</a>{% endif %}
      </div>
    {% elseif expired and h.status == 'open' %}
      <p class="mut">أُغلق باب التسجيل في هذه الدفعة. تابع الموقع ليصلك إعلان الدفعة القادمة بإذن الله.</p>
    {% else %}
      <p class="mut">تابع الموقع ليصلك إعلان فتح التسجيل بإذن الله.</p>
    {% endif %}
  </div>
</section>

{% if internal and reg %}{% include 'partials/register-form.html.twig' %}{% endif %}

{# ── شريط ثابت أسفل الموبايل ───────────────────────────────── #}
{% if h.sticky_cta and can_register %}
<div class="lp-bar">
  <div><b data-price>{{ h.price ?: cta_label }}</b>{% if h.register_deadline %}<span>التسجيل حتى {{ h.register_deadline|date('Y/m/d') }}</span>{% endif %}</div>
  <a class="btn gold btn--sm" href="{{ cta_href }}" {{ blank|raw }}>{{ cta_label }}</a>
</div>
{% endif %}

{# ── العرض الخاص: نافذة تظهر مرة، ومهلة تنتهي فعلاً ────────── #}
{% if h.popup and can_register %}
<div class="lp-pop" id="lp-pop" role="dialog" aria-modal="true" aria-labelledby="lp-pop-t" data-hours="{{ h.popup_hours ?: 1 }}" data-offer-price="{{ h.popup_price }}" data-key="pop:{{ page.route }}">
  <div class="lp-pop__box">
    <button type="button" class="lp-pop__x" data-close aria-label="إغلاق">×</button>
    <p class="lp-eyebrow" style="margin:0 auto">{% include 'partials/lp-icons.html.twig' with {i:'spark', size:16} %} {{ h.popup_badge ?: 'عرض خاص' }}</p>
    <h2 id="lp-pop-t">{{ h.popup_title ?: 'عرضك الخاص' }}</h2>
    {% if h.popup_text %}<p>{{ h.popup_text }}</p>{% endif %}

    {# الأسعار الثلاثة، حتى يفهم الزائر أين يقف #}
    <div class="lp-tiers">
      {% if h.price_before %}<div class="lp-tier"><span>السعر الأساسي</span><s>{{ h.price_before }}</s></div>{% endif %}
      {% if h.price %}<div class="lp-tier"><span>سعر فترة التسجيل</span><s>{{ h.price }}</s></div>{% endif %}
      <div class="lp-tier lp-tier--now"><span>سعرك الآن</span><b>{{ h.popup_price ?: h.price }}</b></div>
    </div>

    <div class="lp-count" data-pop-count role="timer" aria-label="الوقت المتبقي للعرض">
      <span class="lp-count__t">ينتهي عرضك بعد</span>
      <span class="lp-count__u"><b data-h>—</b><i>ساعة</i></span>
      <span class="lp-count__u"><b data-m>—</b><i>دقيقة</i></span>
      <span class="lp-count__u"><b data-s>—</b><i>ثانية</i></span>
    </div>
    <a class="btn gold" href="{{ cta_href }}" data-go {{ blank|raw }}>{{ h.popup_cta ?: cta_label }}</a>
    <p class="lp-fine" style="margin:0">السعر الخاص يسري ما دام العدّاد يعمل، ويُسجَّل مع طلبك.</p>
    <button type="button" class="lp-pop__later" data-close>ليس الآن</button>
  </div>
</div>
{% endif %}
{% endblock %}
