{% extends 'partials/base.html.twig' %}
{#
  A course landing page. Every section below appears only when the page carries its field,
  so a bare course stays a simple page and a full one reads as a landing page.
  Registration: register_mode external (a link) | internal (the site's own form) | none,
  open only while status is "open", the link or form is there and the deadline has not passed.
#}
{%- set h = page.header -%}
{%- set img = media_pick(page, h.image)|first -%}
{%- set qr = media_pick(page, h.pay_qr)|first -%}
{%- set st = {soon: 'التسجيل قريباً', open: 'التسجيل مفتوح', closed: 'التسجيل مغلق', done: 'انتهت الدورة'} -%}
{%- set expired = h.register_deadline and date(h.register_deadline) < date('today') -%}
{%- set internal = h.register_mode == 'internal' -%}
{%- set can_register = h.status == 'open' and h.register_mode != 'none' and not expired and (internal or h.register_url) -%}
{%- set cta_label = h.register_label ?: 'سجّل الآن' -%}
{%- set cta_href = internal ? '#register' : h.register_url -%}
{%- set wa = h.whatsapp ? 'https://wa.me/' ~ h.whatsapp|replace({'+':'', ' ':'', '-':''}) ~ (h.whatsapp_text ? '?text=' ~ h.whatsapp_text|url_encode) -%}

{% block head_extra %}
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"Course","name":"{{ page.title|e('js') }}","inLanguage":"ar",
 "description":"{{ (h.summary ?: page.summary(160)|striptags)|e('js') }}",
 "provider":{"@type":"Person","name":"محمد سائر الشبعان"},"url":"{{ page.url(true)|e('js') }}"}
</script>
{% if h.faq %}
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[
{% for f in h.faq %}{"@type":"Question","name":"{{ f.q|e('js') }}","acceptedAnswer":{"@type":"Answer","text":"{{ f.a|e('js') }}"}}{{ not loop.last ? ',' }}{% endfor %}]}
</script>
{% endif %}
{% endblock %}

{% block content %}
{# ── الواجهة ───────────────────────────────────────────────── #}
<section class="wrap page-head lp-hero">
  {% include 'partials/breadcrumbs.html.twig' %}
  <span class="chip chip--gold" style="align-self:flex-start;margin-top:10px">{{ page.title }}{% if h.batch %} · {{ h.batch }}{% endif %} · {{ expired and h.status == 'open' ? 'انتهى موعد التسجيل' : st[h.status ?: 'soon'] }}</span>
  <h1>{{ h.promise ?: page.title }}</h1>
  {% if h.summary %}<p class="lead">{{ h.summary }}</p>{% endif %}
  <div class="byline"><span>يقدّمها: الشيخ محمد سائر الشبعان</span></div>

  {% set facts = [] %}
  {% if h.start_date %}{% set facts = facts|merge(['البدء: ' ~ h.start_date]) %}{% endif %}
  {% if h.duration %}{% set facts = facts|merge(['المدة: ' ~ h.duration]) %}{% endif %}
  {% if h.format %}{% set facts = facts|merge([h.format]) %}{% endif %}
  {% if h.price %}{% set facts = facts|merge(['الرسوم: ' ~ h.price]) %}{% endif %}
  {% if facts|length %}<div class="chips">{% for f in facts %}<span class="chip">{{ f }}</span>{% endfor %}</div>{% endif %}

  <div class="actions" style="margin-top:6px">
    {% if can_register and internal %}<a class="btn gold" href="#register">{{ cta_label }}</a>
    {% elseif can_register %}<a class="btn gold" href="{{ h.register_url }}" target="_blank" rel="noopener">{{ cta_label }}</a>
    {% elseif expired and h.status == 'open' %}<span class="btn ghost" aria-disabled="true">انتهى موعد التسجيل</span>
    {% else %}<span class="btn ghost" aria-disabled="true">{{ st[h.status ?: 'soon'] }}</span>{% endif %}
    {% if wa and can_register %}<a class="btn ghost" href="{{ wa }}" target="_blank" rel="noopener">{{ h.whatsapp_label ?: 'تواصل على واتساب' }}</a>{% endif %}
  </div>
  {% if h.register_note and can_register %}<p class="mut" style="font-size:15px;margin:-4px 0 0">{{ h.register_note }}</p>{% endif %}

  {% if h.countdown and h.register_deadline and not expired and h.status == 'open' %}
    {% include 'partials/course-countdown.html.twig' %}
  {% endif %}

  {% if h.trailer %}<div class="lp-media">{% include 'partials/youtube.html.twig' with {yt: h.trailer, title: 'تعريف بدورة ' ~ page.title} %}</div>{% endif %}
  {% if img and img.medium %}<div class="article__img lp-media">{{ img.medium.cropZoom(1200, 675).html('', page.title)|raw }}</div>{% endif %}
</section>

{# ── شريط الثقة ────────────────────────────────────────────── #}
{% if h.trust_facts %}
<section class="wrap lp-trust" aria-label="عن المدرّب">
  {% for f in h.trust_facts %}<span>{{ f }}</span>{% endfor %}
</section>
{% endif %}

{# ── هل تجد نفسك هنا؟ ──────────────────────────────────────── #}
{% if h.pains %}
<section class="wrap sec sec--tight">
  <h2 class="lp-h">هل تجد نفسك هنا؟</h2>
  <div class="grid3">
    {% for p in h.pains %}<article class="glass card lp-pain"><p>{{ p }}</p></article>{% endfor %}
  </div>
</section>
{% endif %}

{# ── ماذا ستخرج به ─────────────────────────────────────────── #}
{% if h.goals %}
<section class="wrap sec sec--tight">
  <h2 class="lp-h">ماذا ستخرج به</h2>
  <div class="grid3">
    {% for g in h.goals %}<article class="glass card lp-goal"><span class="lp-num">{{ loop.index }}</span><p>{{ g }}</p></article>{% endfor %}
  </div>
</section>
{% endif %}

{# ── عن الدورة ─────────────────────────────────────────────── #}
{% if page.content|trim %}
<section class="wrap wrap--narrow sec sec--tight">
  <article class="prose">{{ page.content|raw }}</article>
</section>
{% endif %}

{# ── المنهج ────────────────────────────────────────────────── #}
{% set plan = h.curriculum ?: (h.outline ? h.outline|map(c => {title: c, text: ''})) %}
{% if plan %}
<section class="wrap wrap--narrow sec sec--tight">
  <h2 class="lp-h">المنهج</h2>
  <ol class="lp-plan">
    {% for c in plan %}
      <li><span class="lp-num">{{ loop.index }}</span><div><b>{{ c.title }}</b>{% if c.text %}<p class="mut">{{ c.text }}</p>{% endif %}</div></li>
    {% endfor %}
  </ol>
  {% if can_register %}<div class="actions" style="justify-content:center;margin-top:28px"><a class="btn gold" href="{{ cta_href }}" {{ internal ? '' : 'target="_blank" rel="noopener"' }}>{{ cta_label }}</a></div>{% endif %}
</section>
{% endif %}

{# ── لمن هي ولمن ليست ──────────────────────────────────────── #}
{% if h.audience or h.not_for %}
<section class="wrap sec sec--tight">
  <div class="lp-two">
    {% if h.audience %}<div class="glass box lp-for"><h2 class="k">هذه الدورة لك إن…</h2><p>{{ h.audience|nl2br }}</p></div>{% endif %}
    {% if h.not_for %}<div class="glass box lp-notfor"><h2 class="k">وليست لك إن…</h2><ul>{% for n in h.not_for %}<li>{{ n }}</li>{% endfor %}</ul></div>{% endif %}
  </div>
</section>
{% endif %}

{# ── كيف تجري الدورة ───────────────────────────────────────── #}
{% if h.how_it_runs %}
<section class="wrap sec sec--tight">
  <h2 class="lp-h">كيف تجري الدورة</h2>
  <div class="grid3">
    {% for r in h.how_it_runs %}<article class="glass card lp-run"><b>{{ r.title }}</b><p class="mut">{{ r.text }}</p></article>{% endfor %}
  </div>
</section>
{% endif %}

{# ── آراء المتدربين ────────────────────────────────────────── #}
{% if h.testimonials %}
<section class="wrap sec sec--tight">
  <h2 class="lp-h">قالوا بعد الدورة</h2>
  <div class="grid3">
    {% for t in h.testimonials %}
      <figure class="glass card lp-say"><blockquote>{{ t.text }}</blockquote><figcaption>{{ t.name }}</figcaption></figure>
    {% endfor %}
  </div>
</section>
{% endif %}

{# ── الأسئلة الشائعة ───────────────────────────────────────── #}
{% if h.faq %}
<section class="wrap wrap--narrow sec sec--tight">
  <h2 class="lp-h">الأسئلة الشائعة</h2>
  <div class="lp-faq">
    {% for f in h.faq %}
      <details class="glass"><summary>{{ f.q }}</summary><div>{{ f.a|nl2br }}</div></details>
    {% endfor %}
  </div>
</section>
{% endif %}

{# ── التسجيل والدفع ────────────────────────────────────────── #}
<section class="wrap wrap--narrow sec" id="register">
  <div class="glass lp-reg">
    <h2 class="lp-h" style="margin:0">{{ expired and h.status == 'open' ? 'انتهى موعد التسجيل' : (can_register ? 'التسجيل في الدورة' : st[h.status ?: 'soon']) }}</h2>

    {% if h.price %}
      <p class="lp-price">
        {% if h.price_before %}<s>{{ h.price_before }}</s>{% endif %}
        <b>{{ h.price }}</b>
      </p>
      {% if h.price_note %}<p class="mut" style="margin-top:-6px">{{ h.price_note }}</p>{% endif %}
    {% endif %}

    {% if h.register_deadline and not expired %}<p class="mut">آخر موعد للتسجيل: <b>{{ h.register_deadline|date('Y/m/d') }}</b></p>{% endif %}

    {% if can_register %}
      {% if qr and qr.medium %}
        <div class="lp-pay">
          <div class="lp-qr">{{ qr.medium.resize(260, 260).html('', h.pay_title ?: 'رمز الدفع')|raw }}</div>
          <div>
            <b>{{ h.pay_title ?: 'ادفع الرسوم' }}</b>
            {% if h.pay_note %}<p class="mut">{{ h.pay_note|nl2br }}</p>{% endif %}
          </div>
        </div>
      {% elseif h.pay_note %}
        <p class="mut">{{ h.pay_note|nl2br }}</p>
      {% endif %}

      <div class="actions lp-actions">
        {% if wa %}<a class="btn gold" href="{{ wa }}" target="_blank" rel="noopener">{{ h.whatsapp_label ?: 'تواصل معنا على واتساب' }}</a>{% endif %}
        {% if internal %}<a class="btn {{ wa ? 'ghost' : 'gold' }}" href="#register-form">عبّئ نموذج التسجيل</a>
        {% else %}<a class="btn {{ wa ? 'ghost' : 'gold' }}" href="{{ h.register_url }}" target="_blank" rel="noopener">{{ cta_label }}</a>{% endif %}
      </div>
    {% elseif expired and h.status == 'open' %}
      <p class="mut">أُغلق باب التسجيل في هذه الدفعة. تابع الموقع ليصلك إعلان الدفعة القادمة بإذن الله.</p>
    {% else %}
      <p class="mut">تابع الموقع ليصلك إعلان فتح التسجيل بإذن الله.</p>
    {% endif %}
  </div>
</section>

{% if internal and reg %}{% include 'partials/register-form.html.twig' %}{% endif %}

{# ── شريط ثابت أسفل الشاشة ─────────────────────────────────── #}
{% if h.sticky_cta and can_register %}
<div class="lp-bar">
  <div>
    <b>{{ h.price ?: cta_label }}</b>
    {% if h.register_deadline %}<span class="mut">التسجيل حتى {{ h.register_deadline|date('Y/m/d') }}</span>{% endif %}
  </div>
  <a class="btn gold btn--sm" href="{{ cta_href }}" {{ internal ? '' : 'target="_blank" rel="noopener"' }}>{{ cta_label }}</a>
</div>
{% endif %}
{% endblock %}
