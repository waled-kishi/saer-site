# Runtime data that lives only on the server. Hostinger's GitHub deployment
# preserves every path matched here, so content, accounts and settings survive deploys.
/user/pages/*
!/user/pages/.gitkeep
/user/accounts/*
!/user/accounts/.gitkeep
/user/config/*
!/user/config/.gitkeep
/user/data/*
!/user/data/.gitkeep
/user/env/*
!/user/env/.gitkeep
# Per-domain settings that belong to the code (theme choice), tracked on purpose:
!/user/env/saer1.rifd-dt.com/
/cache/*
/logs/*
/tmp/*
/backup/*
/images/*
/assets/*
!/cache/.gitkeep
!/logs/.gitkeep
!/tmp/.gitkeep
!/backup/.gitkeep
!/images/.gitkeep
!/assets/.gitkeep
.env
*.sqlite
.DS_Store
node_modules/
